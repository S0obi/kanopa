<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="tada.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Thibault\Tada">
    </Installer>
    <PackageInformation
        PackageName="Tada"
        PackageDisplayName="Tada"
        PublisherName="CN=Thibault"
        PublisherDisplayName="Thibault"
        Version="0.1.0.0"
        PackageDescription="One big button, endless confetti">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.thibault.tadapoc"
                Description="One big button, endless confetti"
                DisplayName="Tada"
                ExecutableName="tada.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Tada</DisplayName>
            <PublisherDisplayName>Thibault</PublisherDisplayName>
            <Description>One big button, endless confetti</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="tada.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
