<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kanopa.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Kanopa">
    </Installer>
    <PackageInformation
        PackageName="Kanopa"
        PackageDisplayName="Kanopa"
        PublisherName="CN=Thibault"
        PublisherDisplayName="Thibault"
        Version="0.1.0.0"
        PackageDescription="A calm, exact LDAP client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.kanopa.desktop"
                Description="A calm, exact LDAP client"
                DisplayName="Kanopa"
                ExecutableName="kanopa.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Kanopa</DisplayName>
            <PublisherDisplayName>Thibault</PublisherDisplayName>
            <Description>A calm, exact LDAP client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kanopa.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
